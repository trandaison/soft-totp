{
  "autofillRules": {
    "github.com/sessions/two-factor": {
      "mfaInputSelector": "input[name='otp']"
    },
    "accounts.google.com/signin/challenge/*": {
      "mfaInputSelector": "input[id='totpPin']"
    },
    "nalsdn.slack.com": {
      "mfaInputSelector": ".two_factor_input_item input"
    },
    "nalsdn.slack.com/z-app-*": {
      "mfaInputSelector": ".two_factor_input_item input"
    },
    "apps.nulab.com/signin/mfa": {
      "mfaInputSelector": "#authCode"
    },
    "github.com/sessions/two-factor/app": {
      "mfaInputSelector": "#app_totp"
    },
    "id.atlassian.com/login/mfa": {
      "mfaInputSelector": "two-step-verification-otp-code-input"
    },
    "signin.aws.amazon.com/oauth": {
      "mfaInputSelector": "#mfaCode"
    },
    "signin.aws.amazon.com/signin": {
      "mfaInputSelector": "#mfaCode"
    }
  }
}
